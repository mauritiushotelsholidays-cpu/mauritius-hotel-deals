*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;color:#17324d;background:#f7fbfc}a{color:#07648b;text-decoration:none}header{padding:18px 7%;display:flex;justify-content:space-between;background:#fff;box-shadow:0 2px 10px #0001}.logo{font-weight:800;font-size:20px}nav{display:flex;gap:16px}.hero{padding:90px 7%;background:linear-gradient(120deg,#075477,#18a1b5);color:#fff}.hero h1{font-size:52px;max-width:700px}.section{padding:55px 7%;max-width:1300px;margin:auto}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.card{background:#fff;padding:18px;border-radius:12px;box-shadow:0 4px 18px #0001}.pic{height:150px;background:#d7f1ed;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:48px}.large{height:280px}.stars{display:block;color:#c98600;margin-top:12px}.button{display:inline-block;background:#08708f;color:#fff;padding:14px 20px;border:0;border-radius:8px;font-weight:bold}.filters{display:flex;gap:12px;margin-bottom:25px}.filters input,select,input,textarea{padding:12px;width:100%;border:1px solid #ccd7dd;border-radius:7px}.form{max-width:750px}.form form{display:grid;gap:14px}.form label{display:grid;gap:6px;font-weight:bold}.notice{background:#fff2d2;padding:14px;border-left:4px solid #c98600}footer{padding:30px 7%;background:#17324d;color:white}footer a{color:#fff}@media(max-width:800px){.hero h1{font-size:38px}.grid{grid-template-columns:1fr}.filters{flex-direction:column}header{padding:15px 5%;gap:10px}.section{padding:40px 5%}}
import "./globals.css";
export const metadata={title:"Mauritius Hotel Deals",description:"Selected 4-star and 5-star hotels in Mauritius."};
export default function RootLayout({children}){return <html lang="en"><body><header><a className="logo" href="/">Mauritius Hotel Deals</a><nav><a href="/hotels">Hotels</a><a href="/hotels">4 & 5 Star</a><a href="/contact">Contact</a></nav></header><main>{children}</main><footer>© Mauritius Hotel Deals · <a href="/contact">Contact</a> · <a href="/terms">Terms</a> · <a href="/privacy">Privacy</a></footer></body></html>}
import {hotels} from "../data/hotels";
export default function Home(){return <><section className="hero"><p>MAURITIUS HOTEL DEALS</p><h1>Find your Mauritius hotel escape.</h1><p>Explore selected 4-star and 5-star hotels and send us your booking request.</p><a className="button" href="/hotels">Explore Hotels</a></section><section className="section"><h2>Featured Hotels</h2><div className="grid">{hotels.slice(0,6).map(h=><article className="card" key={h.slug}><div className="pic">🌴🏨</div><b className="stars">{"★".repeat(h.stars)}</b><h3>{h.name}</h3><p>📍 {h.location}</p><a href={`/hotels/${h.slug}`}>View hotel →</a></article>)}</div></section></>}
export default function Contact(){return <section className="section"><h1>Contact Us</h1><p>For booking assistance and enquiries:</p><p><b>mauritiushotelsholidays@gmail.com</b></p><a className="button" href="mailto:mauritiushotelsholidays@gmail.com">Email Us</a></section>}
export default function Privacy(){return <section className="section"><h1>Privacy Policy</h1><p>Booking information is used to respond to your request and arrange requested services.</p></section>}
"use client";import {useState} from "react";import {hotels} from "../../data/hotels";
export default function Hotels(){const[q,setQ]=useState("");const[s,setS]=useState("all");const list=hotels.filter(h=>(s==="all"||String(h.stars)===s)&&(`${h.name} ${h.location}`.toLowerCase().includes(q.toLowerCase())));return <section className="section"><h1>Our Hotels</h1><div className="filters"><input placeholder="Search hotel or location" value={q} onChange={e=>setQ(e.target.value)}/><select value={s} onChange={e=>setS(e.target.value)}><option value="all">All hotels</option><option value="4">4 Star</option><option value="5">5 Star</option></select></div><div className="grid">{list.map(h=><article className="card" key={h.slug}><div className="pic">🌴🏨</div><b className="stars">{"★".repeat(h.stars)}</b><h3>{h.name}</h3><p>📍 {h.location}</p><p>{h.shortDescription}</p><a href={`/hotels/${h.slug}`}>View hotel →</a></article>)}</div></section>}
import {hotels} from "../../../data/hotels";import {notFound} from "next/navigation";
export default async function Hotel({params}){const{slug}=await params;const h=hotels.find(x=>x.slug===slug);if(!h)notFound();return <section className="section"><div className="pic large">🌴🏖️🏨</div><b className="stars">{"★".repeat(h.stars)}</b><h1>{h.name}</h1><p>📍 {h.location}, Mauritius</p>{h.adultsOnly&&<p className="notice">Adults-only hotel: applicable age restrictions apply.</p>}{h.closureStart&&<p className="notice">Announced closure period: {h.closureStart} to {h.closureEnd}. Verify before booking.</p>}<h2>About</h2><p>{h.description}</p><h2>Highlights</h2><ul>{h.highlights.map(x=><li key={x}>{x}</li>)}</ul><a className="button" href={`/booking?hotel=${encodeURIComponent(h.name)}`}>Request This Deal</a></section>}
